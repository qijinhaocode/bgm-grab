#!/bin/sh
# push 前复查所有「本地独有」commit 均绑号（已有远端的旧 commit 不回溯）
zero="0000000000000000000000000000000000000000"
bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes";
  else range="$remote_sha..$local_sha"; fi
  for sha in $(git rev-list $range 2>/dev/null); do
    msg=$(git log -1 --format=%s "$sha")
    if ! echo "$msg" | grep -qE 'STORY-[0-9]+'; then
      echo "pre-push 拦截：commit $sha 未绑定 STORY 编号 —— $msg" >&2
      bad=1
    fi
  done
done
[ "$bad" -ne 0 ] && exit 1
exit 0
